# ==============================================================================
# Frontend Environment Configuration Template
# Copy this file to .env and fill in your values
# ==============================================================================

# Supabase Credentials (from Supabase Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backend API URL (choose one)
# Local Backend:
VITE_API_BASE_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# Live VPS Backend:
# VITE_API_BASE_URL=http://72.60.202.148:8020
# VITE_API_URL=http://72.60.202.148:8020

# Production:
# VITE_API_BASE_URL=https://asterisk.getaipilot.in
# VITE_API_URL=https://asterisk.getaipilot.in

# Hub Supabase (optional: used by AuthContext to cross-check plan if not found locally)
VITE_HUB_SUPABASE_URL=https://your-hub-project.supabase.co
VITE_HUB_SUPABASE_ANON_KEY=your-hub-anon-key

# Razorpay Key (frontend display only — secret is in edge function)
VITE_RAZORPAY_KEY_ID=rzp_test_...

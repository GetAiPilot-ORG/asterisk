# ==============================================================================
# Backend Environment Configuration Template
# Copy this file to .env and fill in your values
# ==============================================================================

# Supabase Credentials (from Supabase Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_KEY=your-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# External APIs
OPENAI_API_KEY=sk-...
DEEPGRAM_API_KEY=...
ELEVENLABS_API_KEY=...
SARVAM_API_KEY=...

# Telephony (Telnyx or Twilio)
TELEPHONY_PROVIDER=telnyx
TELNYX_API_KEY=...
TELNYX_ACCOUNT_SID=...
TELNYX_CONNECTION_ID=...
TELNYX_WEBHOOK_URL=https://your-backend.com/api/webhooks/telnyx
TELNYX_PHONE_NUMBER=...

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WEBHOOK_URL=https://your-backend.com/api/webhooks/twilio
TWILIO_PHONE_NUMBER=...

# Local Agent Knowledge Base
LOCAL_AGENT_KNOWLEDGE_BASE_PATH=../GAP_calling_assistent/knowledge_base.txt
PUBLIC_BASE_URL=http://localhost:8000

# Redis & Celery (Optional locally, fallback scheduler active if not connected)
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# Asterisk AudioSocket & Webhooks
ASTERISK_AUDIOSOCKET_ENABLED=true
ASTERISK_AUDIOSOCKET_HOST=127.0.0.1
ASTERISK_AUDIOSOCKET_PORT=9092
ASTERISK_WEBHOOK_SECRET=your_shared_secret
ASTERISK_PROVIDER_NAME=airtel
ASTERISK_DEFAULT_SAMPLE_RATE=8000
ASTERISK_MODE=vps

# SSO Login Secret
VOICE_PILOT_SSO_SECRET=your_voice_pilot_sso_secret

# Call Admission Control (CAC) Configuration
ALLOW_CALLS_WITHOUT_REDIS=true
DEFAULT_WORKSPACE_MAX_CONCURRENT_CALLS=1
DEFAULT_AGENT_MAX_CONCURRENT_CALLS=1
CALL_RESERVATION_TTL_SECONDS=7200
CALL_USAGE_MONITOR_INTERVAL_SECONDS=15
BLOCK_OVERDUE_WORKSPACES=true
